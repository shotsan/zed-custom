#!/usr/bin/env bash

set -euxo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <release_version>"
  exit 1
fi

mkdir -p snap/gui

export DO_STARTUP_NOTIFY="true"
export APP_NAME="zed-custom"
export APP_CLI="zed-custom"
export APP_ICON="\${SNAP}/meta/gui/zed-custom.png"
export APP_ARGS="%U"
envsubst < "crates/zed-custom/resources/zed-custom.desktop.in" > "snap/gui/zed-custom.desktop"
cp "crates/zed-custom/resources/app-icon.png" "snap/gui/zed-custom.png"

RELEASE_VERSION="$1" envsubst < crates/zed-custom/resources/snap/snapcraft.yaml.in > snap/snapcraft.yaml

# Clean seems to be needed to actually check that the snapcraft.yaml
# works.  For example, when a `stage-package` is removed, it will
# still remain on rebuild.
snapcraft clean

snapcraft
