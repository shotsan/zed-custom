#!/bin/bash
# Validates Azure Anthropic API connectivity and model availability.
# Usage: ./script/test-azure-anthropic [model_name]
#
# Reads API key from AZURE_ANTHROPIC_API_KEY env var or local_secrets.env.
# Tests the exact same endpoint + headers that zed-custom's Anthropic provider uses.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

API_URL="https://serveringmodels.services.ai.azure.com/anthropic/v1/messages"
MODEL="${1:-claude-haiku-4-5}"

# Try to load the API key from env or local_secrets.env
if [ -z "${AZURE_ANTHROPIC_API_KEY:-}" ] && [ -f "$PROJECT_ROOT/local_secrets.env" ]; then
    source "$PROJECT_ROOT/local_secrets.env"
fi

if [ -z "${AZURE_ANTHROPIC_API_KEY:-}" ]; then
    echo "ERROR: Set AZURE_ANTHROPIC_API_KEY env var or add it to local_secrets.env"
    exit 1
fi

echo "=== Azure Anthropic API Test ==="
echo "Endpoint: $API_URL"
echo "Model:    $MODEL"
echo "API Key:  ${AZURE_ANTHROPIC_API_KEY:0:8}..."
echo ""

RESPONSE=$(curl -s -w "\n---HTTP_CODE:%{http_code}---" \
    -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -H "x-api-key: $AZURE_ANTHROPIC_API_KEY" \
    -H "anthropic-version: 2023-06-01" \
    -d "{
        \"max_tokens\": 100,
        \"temperature\": 0.0,
        \"messages\": [{\"role\": \"user\", \"content\": \"Reply with exactly: OK\"}],
        \"model\": \"$MODEL\"
    }")

HTTP_CODE=$(echo "$RESPONSE" | grep -o 'HTTP_CODE:[0-9]*' | cut -d: -f2)
BODY=$(echo "$RESPONSE" | sed 's/---HTTP_CODE:[0-9]*---//')

if [ "$HTTP_CODE" = "200" ]; then
    echo "✅ SUCCESS (HTTP $HTTP_CODE)"
    echo ""
    REPLY=$(echo "$BODY" | python3 -c "import sys,json; print(json.load(sys.stdin)['content'][0]['text'])" 2>/dev/null || echo "$BODY")
    echo "Model response: $REPLY"
    RETURNED_MODEL=$(echo "$BODY" | python3 -c "import sys,json; print(json.load(sys.stdin)['model'])" 2>/dev/null || echo "unknown")
    echo "Returned model: $RETURNED_MODEL"
else
    echo "❌ FAILED (HTTP $HTTP_CODE)"
    echo ""
    echo "$BODY" | python3 -m json.tool 2>/dev/null || echo "$BODY"
fi

echo ""
echo "=== zed-custom Config Reminder ==="
echo "In settings.json, use:"
echo "  \"api_url\": \"https://serveringmodels.services.ai.azure.com/anthropic\""
echo "  Model name in zed-custom must match: \"$MODEL\""
